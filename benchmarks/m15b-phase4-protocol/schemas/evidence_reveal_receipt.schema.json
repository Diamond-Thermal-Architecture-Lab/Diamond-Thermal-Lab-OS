{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diamond-thermal-lab.example/schemas/m15b-phase4/evidence-reveal-receipt-2.0.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["artifact_id", "generated_at_utc", "phase3_anchor", "pre_reveal_lock", "delivery_verification", "reveal_status"],
  "properties": {
    "artifact_id": {"const": "evidence_reveal_receipt"},
    "generated_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "phase3_anchor": {"type": "object", "additionalProperties": false, "required": ["commit", "tree", "first_parent", "second_parent"], "properties": {"commit": {"const": "1f8d258030f1330e022dec34bab608fef46b54c9"}, "tree": {"const": "772aba695aac5726df4c0b8193ba0bad5dbab24f"}, "first_parent": {"const": "2b45c63128dad6793dd753ca9300538769af8c53"}, "second_parent": {"const": "61753ff5e3398f30f983682b59c04fc4ad0449f1"}}},
    "pre_reveal_lock": {"const": "established"},
    "delivery_verification": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["registered_evidence_identifier", "byte_length_verified", "sha256_verified", "media_type_verified"], "properties": {"registered_evidence_identifier": {"type": "string", "enum": ["m15b-sealed-relevance-registration", "m15b-sealed-scope-registration", "m15b-sealed-scoring-registration", "m15b-sealed-source-dossier"]}, "byte_length_verified": {"type": "boolean", "const": true}, "sha256_verified": {"type": "boolean", "const": true}, "media_type_verified": {"type": "boolean", "const": true}}}, "allOf": [
      {"contains": {"type": "object", "properties": {"registered_evidence_identifier": {"const": "m15b-sealed-relevance-registration"}}, "required": ["registered_evidence_identifier"]}, "minContains": 1, "maxContains": 1},
      {"contains": {"type": "object", "properties": {"registered_evidence_identifier": {"const": "m15b-sealed-scope-registration"}}, "required": ["registered_evidence_identifier"]}, "minContains": 1, "maxContains": 1},
      {"contains": {"type": "object", "properties": {"registered_evidence_identifier": {"const": "m15b-sealed-scoring-registration"}}, "required": ["registered_evidence_identifier"]}, "minContains": 1, "maxContains": 1},
      {"contains": {"type": "object", "properties": {"registered_evidence_identifier": {"const": "m15b-sealed-source-dossier"}}, "required": ["registered_evidence_identifier"]}, "minContains": 1, "maxContains": 1}
    ]},
    "reveal_status": {"type": "string", "enum": ["opened", "completed"]}
  }
}
