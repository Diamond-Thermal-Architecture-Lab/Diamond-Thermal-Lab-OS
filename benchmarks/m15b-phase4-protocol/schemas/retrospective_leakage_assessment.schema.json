{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diamond-thermal-lab.example/schemas/m15b-phase4/retrospective-leakage-assessment-2.0.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["artifact_id", "coverage", "assessments"],
  "properties": {"artifact_id": {"const": "retrospective_leakage_assessment"}, "coverage": {"type": "object", "additionalProperties": false, "required": ["required_unit_count", "assessed_unit_count", "omitted_unit_count", "duplicate_unit_count", "required_unit_set_sha256", "assessed_unit_set_sha256"], "properties": {"required_unit_count": {"type": "integer", "minimum": 1}, "assessed_unit_count": {"type": "integer", "minimum": 1}, "omitted_unit_count": {"type": "integer", "const": 0}, "duplicate_unit_count": {"type": "integer", "const": 0}, "required_unit_set_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "assessed_unit_set_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}, "assessments": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["assessment_id", "blind_comparison_unit_id", "authorized_input_provenance", "overlap_category", "distinctiveness", "leakage_disposition", "uncertainty", "minimum_disclosure"], "properties": {"assessment_id": {"type": "string", "pattern": "^M15B-P4-LK-[0-9]{8}$"}, "blind_comparison_unit_id": {"type": "string", "pattern": "^M15B-P4-CAU-[a-f0-9]{64}$"}, "authorized_input_provenance": {"type": "string", "minLength": 1, "maxLength": 600}, "overlap_category": {"type": "string", "enum": ["authorized_input", "generic_domain_overlap", "distinctive_evidence_specific_overlap", "unsupported_evidence_specific_detail", "indeterminate_overlap"]}, "distinctiveness": {"type": "string", "enum": ["generic", "potentially_distinctive", "distinctive", "indeterminate"]}, "leakage_disposition": {"type": "string", "enum": ["no_evidence_of_leakage", "requires_independent_review", "evidence_of_leakage", "indeterminate"]}, "uncertainty": {"type": "string", "minLength": 1, "maxLength": 600}, "minimum_disclosure": {"type": "string", "minLength": 1, "maxLength": 600}, "evidence_reference": {"type": "object", "additionalProperties": false, "required": ["registered_evidence_identifier", "locator"], "properties": {"registered_evidence_identifier": {"type": "string", "enum": ["m15b-sealed-relevance-registration", "m15b-sealed-scope-registration", "m15b-sealed-scoring-registration", "m15b-sealed-source-dossier"]}, "locator": {"type": "object", "additionalProperties": false, "required": ["registered_evidence_identifier", "kind", "value"], "properties": {"registered_evidence_identifier": {"type": "string", "enum": ["m15b-sealed-relevance-registration", "m15b-sealed-scope-registration", "m15b-sealed-scoring-registration", "m15b-sealed-source-dossier"]}, "kind": {"type": "string", "enum": ["page", "section", "figure", "table", "paragraph", "record"]}, "value": {"type": "string", "minLength": 1, "pattern": "^(?!.*(?:[A-Za-z]:[\\/]|/|\\\\|https?://|token|credential|tmp|temp)).+$"}}}}}}}}},
  "allOf": [{"$comment": "Mandatory semantic validator uses the identical frozen comparison-unit inventory, enforces unique unit IDs, exact complete coverage/digest/counts and identifier/locator binding, and treats correctness alone as insufficient leakage evidence."}]
}
