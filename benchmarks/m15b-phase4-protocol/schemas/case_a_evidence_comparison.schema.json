    "comparison_records":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["comparison_unit_id","frozen_phase3_artifact_path","blind_output_locator","evidence_references","relationship","materiality","discrepancy_category","effect_on_triage","effect_on_decision_board","effect_on_engineering_memory","rationale","uncertainty","corrective_lesson","future_change_recommendation_status"],"properties":{
      "comparison_unit_id":{"type":"string","pattern":"^M15B-P4-CAU-[a-f0-9]{64}$"},"frozen_phase3_artifact_path":{"type":"string","pattern":"^(cases/m15b-case-a/(10_claim_ledger.yml|11_engineering_memory_entry.md)|exports/m15b-case-a-phase3/(triage_result.json|decision_board_preview.json))$"},"blind_output_locator":{"type":"string","minLength":1},
